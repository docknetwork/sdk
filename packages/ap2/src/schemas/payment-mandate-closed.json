{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Closed Payment Mandate Content",
  "description": "The disclosed content of a Closed Payment Mandate (mandate.payment.1).",
  "type": "object",
  "properties": {
    "vct": {
      "const": "mandate.payment.1"
    },
    "transaction_id": {
      "type": "string",
      "description": "base64url hash of the associated Checkout Mandate's checkout_jwt (same value as that mandate's checkout_hash)."
    },
    "payee": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string" }
      }
    },
    "payment_amount": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string" }
      }
    },
    "payment_instrument": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "pisp": {
      "type": "object"
    },
    "execution_date": {
      "type": "string"
    },
    "risk_data": {
      "type": "object"
    }
  },
  "required": ["vct", "transaction_id", "payee", "payment_amount", "payment_instrument"],
  "additionalProperties": true
}
