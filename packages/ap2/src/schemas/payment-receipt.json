{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.truvera.io/PaymentReceipt-V1-1784315531394.json",
  "title": "Payment Receipt",
  "name": "Payment Receipt",
  "description": "Receipt that supplies information about the final state of a payment.",
  "type": "object",
  "properties": {
    "status": {
      "description": "The status of the payment.",
      "$ref": "#/$defs/receipt_status"
    },
    "iss": {
      "type": "string",
      "description": "The issuer of the receipt."
    },
    "iat": {
      "type": "integer",
      "description": "The creation timestamp as a Unix epoch."
    },
    "reference": {
      "type": "string",
      "description": "The hash of the closed Mandate that this receipt is binding to."
    },
    "error": {
      "type": "string",
      "description": "A unique error code. Present if and only if status is Error."
    },
    "error_description": {
      "type": "string",
      "description": "A human-readable error description. Present if and only if status is Error."
    },
    "payment_id": {
      "type": "string",
      "description": "A unique identifier for the payment."
    },
    "psp_confirmation_id": {
      "type": "string",
      "description": "A unique identifier for the transaction confirmation at the PSP. Present only if status is Success."
    },
    "network_confirmation_id": {
      "type": "string",
      "description": "A unique identifier for the transaction confirmation at the network. Present only if status is Success."
    }
  },
  "required": [
    "status",
    "iss",
    "iat",
    "reference",
    "payment_id"
  ],
  "oneOf": [
    {
      "title": "Payment Receipt Success",
      "properties": {
        "status": {
          "const": "Success"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "error_description"
            ]
          }
        ]
      }
    },
    {
      "title": "Payment Receipt Error",
      "properties": {
        "status": {
          "const": "Error"
        }
      },
      "required": [
        "error",
        "error_description"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "psp_confirmation_id"
            ]
          },
          {
            "required": [
              "network_confirmation_id"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "receipt_status": {
      "title": "Receipt Status",
      "description": "The status of a receipt.",
      "type": "string",
      "enum": [
        "Success",
        "Error"
      ]
    }
  },
  "$metadata": {
    "version": 1,
    "uris": {
      "jsonSchema": "https://schema.truvera.io/PaymentReceipt-V1-1784315531394.json",
      "jsonLdContext": "https://schema.truvera.io/PaymentReceipt-V1784315531394.json-ld"
    }
  },
  "additionalProperties": true
}